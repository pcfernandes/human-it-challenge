# Copy this file to .env and replace each placeholder with a local value.
# Do not commit .env or use these placeholders as production credentials.
POSTGRES_DB=humanit
POSTGRES_USER=humanit
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Generate a Base64 secret from at least 32 random bytes.
APP_SECURITY_JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
APP_SECURITY_USER_USERNAME=replace-with-a-local-username
# Supply a BCrypt hash for a local password of your choice. If it contains $, single-quote
# the value in .env so Compose treats it literally, e.g. KEY='$2a$...'.
APP_SECURITY_USER_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
