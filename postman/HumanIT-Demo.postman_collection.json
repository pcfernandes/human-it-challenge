                  "const json = pm.response.json();",
                  "pm.environment.set(\"documentId\", json.id);",
                  "pm.environment.set(\"documentVersion\", json.version);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh client version after document create",
          "request": {
            "method": "GET",
