{
  "info": {
    "name": "Human IT Demo",
    "description": "Demo requests for the Human IT challenge API. Import with postman/HumanIT-Local.postman_environment.json. Set username and password in the environment, then run Login first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set(\"token\", json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login with invalid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Client\",\n  \"taxIdentifier\": \"TAX-001\",\n  \"email\": \"demo.client@example.com\",\n  \"phoneNumber\": \"+1 555 0100\",\n  \"documents\": [\n    {\n      \"number\": \"DOC-001\",\n      \"description\": \"Initial document\",\n      \"expirationDate\": \"2027-12-31\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set(\"clientId\", json.id);",
                  "pm.environment.set(\"clientVersion\", json.version);",
                  "if (json.documents && json.documents.length > 0) {",
                  "    pm.environment.set(\"documentId\", json.documents[0].id);",
                  "    pm.environment.set(\"documentVersion\", json.documents[0].version);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get client",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set(\"clientVersion\", json.version);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update client (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Client\",\n  \"taxIdentifier\": \"TAX-001\",\n  \"email\": \"updated.client@example.com\",\n  \"phoneNumber\": \"+1 555 0199\",\n  \"version\": {{clientVersion}},\n  \"documents\": []\n}"
            },
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set(\"clientVersion\", json.version);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Patch client (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Patched\",\n  \"version\": {{clientVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set(\"clientVersion\", json.version);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List clients with invalid page size",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients?page=0&size=101"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get missing client",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create client with duplicate tax identifier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Duplicate\",\n  \"lastName\": \"Client\",\n  \"taxIdentifier\": \"TAX-001\",\n  \"email\": \"duplicate.client@example.com\",\n  \"phoneNumber\": \"+1 555 0101\"\n}"
            },
            "url": "{{baseUrl}}/api/clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Create document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Client-Version",
                "value": "{{clientVersion}}"
              }
